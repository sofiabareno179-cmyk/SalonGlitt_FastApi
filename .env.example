# SGE-API · configuración local.
#
# Copie este archivo como .env en la raíz del proyecto sge-api y reemplace los
# marcadores. El .env real NUNCA se versiona: debe estar en .gitignore.
# Si algún día aparece en `git status`, deténgase antes de hacer commit.

# Genere la clave de firma con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sin valor por defecto en el código: si falta, la aplicación no arranca, y ese
# fallo ruidoso el primer día vale más que una filtración silenciosa el día 80.
SGE_SECRET_KEY=<pegue-aqui-la-clave-generada>

# PostgreSQL 16. Controlador asíncrono obligatorio: asyncpg, no psycopg2.
#
# Este valor solo se usa cuando la API corre FUERA de Docker. Con
# `docker compose up`, docker-compose.yml sobrescribe esta variable y apunta a
# `db:5432`, que es como el servicio se llama dentro de la red de Compose.
SGE_DATABASE_URL=postgresql+asyncpg://<usuario>:<clave>@127.0.0.1:5434/sge

# --- Coolify · base de datos administrada -------------------------------
#
# En el panel de Coolify, pestaña Environment Variables del recurso de la API,
# declara SGE_DATABASE_URL (con el prefijo SGE_, nunca DATABASE_URL a secas)
# con la URL que muestra el recurso de la base, haciendo dos cambios:
#
#   1. el prefijo del driver: postgresql+asyncpg:// en vez de postgresql://
#      (psycopg2 es síncrono y no está instalado; la app necesita asyncpg)
#   2. nada más: el host postgres-db-... solo resuelve dentro de la red de
#      Coolify, por eso no sirve en este archivo local.
#
# El indicador se declara con el mismo nombre, SGE_DATABASE_URL, una sola vez.

# false en cualquier entorno que no sea el computador de quien desarrolla.
# Con true, FastAPI responde con la traza completa: rutas del servidor,
# versiones de bibliotecas y a veces fragmentos de la consulta que falló.
SGE_DEBUG=false

# Vigencia del token de acceso, en minutos. Entre 5 y 1440.
SGE_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes del navegador que pueden llamar a esta API. Necesario en producción:
# sin esta línea, el panel de React servido desde el dominio real recibe un
# error de CORS en cada llamada, porque la lista de desarrollo no lo incluye.
# Admite JSON o lista con comas.
SGE_CORS_ORIGINS=["http://localhost:8030","http://127.0.0.1:8030","http://localhost:3000"]

# Vacío en el caso normal. Solo si el proxy publica la API bajo un prefijo de
# ruta, por ejemplo https://tudominio.com/api. Debe coincidir con ese prefijo.
# SGE_ROOT_PATH=/api

# Servicio `db` de docker-compose. Opcionales: el compose trae valores por
# defecto (usuario `sge`, base `sge`), así que basta con declarar
# POSTGRES_PASSWORD con una clave fuerte; POSTGRES_DB solo si usa otra base.
# POSTGRES_PASSWORD=<clave-de-la-base>
# POSTGRES_USER=sge
# POSTGRES_DB=sge
